# Database (Neon PostgreSQL) - Using 'savey' schema
DATABASE_URL=postgres://neondb_owner:npg_zOQAHDxvM5h7@ep-green-pine-a2y91p4h-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&options=-c%20search_path%3Dsavey

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://redis:6379
REDIS_CHAT_QUEUE=chat_queue
REDIS_CHAT_CHANNEL_PREFIX=chat

# Internal service auth
INTERNAL_API_TOKEN=change-me-internal-secret

# RabbitMQ (unused)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=savey
RABBITMQ_QUEUE=llm_messages
RABBITMQ_ROUTING_KEY=llm.message

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=Savey API
